:17Z","channelTitle":"天野こころ","thumbnails":{"default":{"url":"https://i.ytimg.com/vi/BxQStPHf3XQ/default.jpg","width":120,"height":90},"medium":{"url":"https://i.ytimg.com/vi/BxQStPHf3XQ/mqdefault.jpg","width":320,"height":180},"high":{"url":"https://i.ytimg.com/vi/BxQStPHf3XQ/hqdefault.jpg","width":480,"height":360},"standard":{"url":"https://i.ytimg.com/vi/BxQStPHf3XQ/sddefault.jpg","width":640,"height":480},"maxres":{"url":"https://i.ytimg.com/vi/BxQStPHf3XQ/maxresdefault.jpg","width":1280,"height":720}},"viewCount":918}]},{"input":"UC4Hd5gecMapkLhMgjAk2HeA","channelTitle":"岡本ゆうじ【再生の道】","channelThumbnails":{"default":{"url":"https://yt3.ggpht.com/oaKseO1TBS3ULSENpXfXHe50wcZrY9vXQ42_2NaTN9z7Vi5tV8R4rRiXedh2jG_4Mh4RFEUMOEc=s88-c-k-c0x00ffffff-no-rj","width":88,"height":88},"medium":{"url":"https://yt3.ggpht.com/oaKseO1TBS3ULSENpXfXHe50wcZrY9vXQ42_2NaTN9z7Vi5tV8R4rRiXedh2jG_4Mh4RFEUMOEc=s240-c-k-c0x00ffffff-no-rj","width":240,"height":240},"high":{"url":"https://yt3.ggpht.com/oaKseO1TBS3ULSENpXfXHe50wcZrY9vXQ42_2NaTN9z7Vi5tV8R4rRiXedh2jG_4Mh4RFEUMOEc=s800-c-k-c0x00ffffff-no-rj","width":800,"height":800}},"channelId":"UC4Hd5gecMapkLhMgjAk2HeA","liveVideos":[],"recentVideos":[]},{"input":"UCvlUZ8XJp0jthtKfLG1i_hQ","channelTitle":"【公式】坪田こうすけ「つぼチャンネル」","channelThumbnails":{"default":{"url":"https://yt3.ggpht.com/lO9JBbO6_bN4CeVC7t3H5_mgaTA8h7PvmZF8F8IAU-vt-JLtdA_aRqK89fIbBKQNKOk9yQdW=s88-c-k-c0x00ffffff-no-rj","width":88,"height":88},"medium":{"url":"https://yt3.ggpht.com/lO9JBbO6_bN4CeVC7t3H5_mgaTA8h7PvmZF8F8IAU-vt-JLtdA_aRqK89fIbBKQNKOk9yQdW=s240-c-k-c0x00ffffff-no-rj","width":240,"height":240},"high":{"url":"https://yt3.ggpht.com/lO9JBbO6_bN4CeVC7t3H5_mgaTA8h7PvmZF8F8IAU-vt-JLtdA_aRqK89fIbBKQNKOk9yQdW=s800-c-k-c0x00ffffff-no-rj","width":800,"height":800}},"channelId":"UCvlUZ8XJp0jthtKfLG1i_hQ","liveVideos":[],"recentVideos":[]}]}