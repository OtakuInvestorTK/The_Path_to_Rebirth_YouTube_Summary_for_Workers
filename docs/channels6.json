uCkfisRyQ","liveVideos":[],"recentVideos":[]},{"input":"UCbnf2Gl6Pra9DPDeMBV2a3w","channelTitle":"南貴大のずぼらジオ","channelThumbnails":{"default":{"url":"https://yt3.ggpht.com/LQoghKMjTvDW79bfGxKaFy7iJvSmIJgSvtq3yZmBQOl93x-hwcfrS6648t_t4-wLI17FlFKg7qA=s88-c-k-c0x00ffffff-no-rj","width":88,"height":88},"medium":{"url":"https://yt3.ggpht.com/LQoghKMjTvDW79bfGxKaFy7iJvSmIJgSvtq3yZmBQOl93x-hwcfrS6648t_t4-wLI17FlFKg7qA=s240-c-k-c0x00ffffff-no-rj","width":240,"height":240},"high":{"url":"https://yt3.ggpht.com/LQoghKMjTvDW79bfGxKaFy7iJvSmIJgSvtq3yZmBQOl93x-hwcfrS6648t_t4-wLI17FlFKg7qA=s800-c-k-c0x00ffffff-no-rj","width":800,"height":800}},"channelId":"UCbnf2Gl6Pra9DPDeMBV2a3w","liveVideos":[],"recentVideos":[{"videoId":"0sSmhX7pagc","title":"休暇は太陽チャージ？ドイツ人の有給休暇が独特すぎた","description":"今回は、ドイツ人の有給休暇の取り方についてお話しします。\n\nドイツでは、有給は「できれば取るもの」ではなく、基本的に「使うもの」。\nしかも、2週間ほど連続で休むことも珍しくありません。\n\n日本人の旅行は短期間でいろいろな場所を回ることが多いですが、ドイツ人は一つの場所に長く滞在して、キッチン付きのアパートで自炊しながらのんびり過ごすこともあります。\n\nいわば「暮らすように休む」文化です。\n\nさらに、ドイツ国内のオストゼーやスペインのマヨルカ島など、ドイツ人に人気の休暇先についてもお話しします。\n\n日本は「隙間に休む」文化。\nドイツは「切り取って、丸ごと休む」文化。\n\n皆さんは、どちらの休み方が自分に合っていますか？\n\n#ドイツ生活 #ドイツ文化 #有給休暇 #バカンス #ずぼらジオ","publishedAt":"2026-05-09T00:00:03Z","channelTitle":"南貴大のずぼらジオ","thumbnails":{"default":{"url":"https://i.ytimg.com/vi/0sSmhX7pagc/default.jpg","width":120,"height":90},"medium":{"url":"https://i.ytimg.com/vi/0sSmhX7pagc/mqdefault.jpg","width":320,"height":180},"high":{"url":"https://i.ytimg.com/vi/0sSmhX7pagc/hqdefault.jpg","width":480,"height":360},"standard":{"url":"https://i.ytimg.com/vi/0sSmhX7pagc/sddefault.jpg","width":640,"height":480},"maxres":{"url":"https://i.ytimg.com/vi/0sSmhX7pagc/maxresdefault.jpg","width":1280,"height":720}},"viewCount":395},{"videoId":"w0H3axQzaoc","title":"海外の会社＝全員名前呼び？ドイツではそんな単純じゃなかった","description":"今回は、ドイツの会社で本当にファーストネームで呼び合うのか、というテーマでお話しします。\n\n海外では上司も部下も名前で呼び合う、というイメージがありますよね。\nでもドイツでは、いきなりファーストネームで呼ぶとは限りません。\n\n最初は名字で呼び合い、あるタイミングで相手から「名前で呼び合いましょう」と提案されることがあります。\n\nさらにドイツ語には、敬語的な「Sie」と、親しい相手に使う「du」があり、呼び方の変化は人間関係の距離感そのものに関わっています。\n\n日本は空気で距離を測る文化。\nドイツは言葉で距離を決める文化。\n\nドイツの職場で体験した、ファーストネーム文化のリアルをゆるくお話しします。\n\n#ドイツ生活 #ドイツ文化 #職場文化 #ドイツ語 #ずぼらジオ","publishedAt":"2026-05-06T09:01:20Z","channelTitle":"南貴大のずぼらジオ","thumbnails":{"default":{"url":"https://i.ytimg.com/vi/w0H3axQzaoc/default.jpg","width":120,"height":90},"medium":{"url":"https://i.ytimg.com/vi/w0H3axQzaoc/mqdefault.jpg","width":320,"height":180},"high":{"url":"https://i.ytimg.com/vi/w0H3axQzaoc/hqdefault.jpg","width":480,"height":360},"standard":{"url":"https://i.ytimg.com/vi/w0H3axQzaoc/sddefault.jpg","width":640,"height":480},"maxres":{"url":"https://i.ytimg.com/vi/w0H3axQzaoc/maxresdefault.jpg","width":1280,"height":720}},"viewCount":922}]}]}