-k-c0x00ffffff-no-rj","width":88,"height":88},"medium":{"url":"https://yt3.ggpht.com/whJsqMqFNCPRyKsK1CUQsyqHcltRvpvNfogxBUmufXKfisJNGRcfucOOtTk5onm1oNm-ejFi1uA=s240-c-k-c0x00ffffff-no-rj","width":240,"height":240},"high":{"url":"https://yt3.ggpht.com/whJsqMqFNCPRyKsK1CUQsyqHcltRvpvNfogxBUmufXKfisJNGRcfucOOtTk5onm1oNm-ejFi1uA=s800-c-k-c0x00ffffff-no-rj","width":800,"height":800}},"channelId":"UCmnx46pzvRWi4-Ae-Dqnq9A","liveVideos":[],"recentVideos":[{"videoId":"mmlGdQjxIVM","title":"地方創生と地域活性化の提案#02 地域に深く関わる - 移住・転職という選択肢","description":"","publishedAt":"2025-10-11T22:00:50Z","channelTitle":"やなぎさわ誉之(たかゆき)【道は続くよどこまでも】","thumbnails":{"default":{"url":"https://i.ytimg.com/vi/mmlGdQjxIVM/default.jpg","width":120,"height":90},"medium":{"url":"https://i.ytimg.com/vi/mmlGdQjxIVM/mqdefault.jpg","width":320,"height":180},"high":{"url":"https://i.ytimg.com/vi/mmlGdQjxIVM/hqdefault.jpg","width":480,"height":360},"standard":{"url":"https://i.ytimg.com/vi/mmlGdQjxIVM/sddefault.jpg","width":640,"height":480},"maxres":{"url":"https://i.ytimg.com/vi/mmlGdQjxIVM/maxresdefault.jpg","width":1280,"height":720}},"viewCount":636},{"videoId":"3664t6ZuPHg","title":"出張先から雑談配信in高岡_2025年10月09日","description":"【高岡の見どころ】\n * 国宝瑞龍寺と高岡大仏: 加賀藩ゆかりの国宝「瑞龍寺」と、日本三大大仏に数えられる「高岡大仏」。歴史と信仰が息づく荘厳な空間を体感できます。\n * 鋳物の町並み「金屋町」: 約400年の歴史を持つ高岡鋳物発祥の地。千本格子（さまのこ）の美しい家々が連なる町並みを散策し、ものづくりの心に触れることができます。\n * 雨晴海岸の絶景: 富山湾越しに、標高3,000m級の立山連峰を望むことができる景勝地。四季折々の雄大な景色は、まさに息をのむ美しさです。\n * まんがとグルメを堪能: 藤子・F・不二雄先生の故郷であり、街中を走る「ドラえもんトラム」は人気の的。富山湾の宝石と称されるシロエビや、ブリ、ホタルイカなど、新鮮な海の幸も絶品です。\n\n【富山県高岡市とは？】\n富山県の北西部に位置する高岡市は、加賀前田家二代当主・前田利長によって開かれた城下町です。\n400年以上の歴史を持つ「高岡銅器」などの伝統産業が根付く”ものづくりの町”として知られています。\n国宝・瑞龍寺や歴史的な町並み、そして雨晴海岸の絶景など、歴史・文化・自然が調和した魅力あふれる地域です。\n\n高岡市観光ポータルサイト「たかおか道しるべ」はこちら：https://www.takaoka.or.jp/","publishedAt":"2025-10-09T16:27:14Z","channelTitle":"やなぎさわ誉之(たかゆき)【道は続くよどこまでも】","thumbnails":{"default":{"url":"https://i.ytimg.com/vi/3664t6ZuPHg/default.jpg","width":120,"height":90},"medium":{"url":"https://i.ytimg.com/vi/3664t6ZuPHg/mqdefault.jpg","width":320,"height":180},"high":{"url":"https://i.ytimg.com/vi/3664t6ZuPHg/hqdefault.jpg","width":480,"height":360},"standard":{"url":"https://i.ytimg.com/vi/3664t6ZuPHg/sddefault.jpg","width":640,"height":480},"maxres":{"url":"https://i.ytimg.com/vi/3664t6ZuPHg/maxresdefault.jpg","width":1280,"height":720}},"viewCount":2736,"liveStreaming":{"status":"completed","scheduledStartTime":"2025-10-09T14:00:00Z","actualStartTime":"2025-10-09T14:02:06Z","actualEndTime":"2025-10-09T15:07:15Z"}},{"videoId":"c_muaAm-aQE","title":"出張先から雑談配信in石巻_2025年10月07日","description":"【石巻の見どころ】\n * マンガの世界に浸る: 石巻は「萬画の国」。サイボーグ009や仮面ライダーの生みの親、石ノ森章太郎先生の記念館「石ノ森萬画館」は必見です。街の至る所にキャラクターのモニュメントがあり、歩くだけで楽しめます。\n * 絶景の島々と猫の楽園: 牡鹿半島の先に浮かぶ、自然豊かな島々を訪れることができます。特に「田代島」は\"猫の島\"として世界的に有名で、たくさんの猫たちが自由気ままに暮らしています。\n * 世界有数の漁港で味わう新鮮な海の幸: 世界三大漁場の一つ、三陸沖に面する石巻漁港。ブランド魚の「金華さば」をはじめ、牡蠣やホヤ、旬の魚介類を使った海鮮丼など、ここでしか味わえない絶品グルメが満載です。\n * 復興の歩みを学ぶ旅: 東日本大震災の甚大な被害から力強く復興を続ける街の姿に触れることができます。震災の記憶と教訓を未来へ伝える伝承館などを訪れ、防災や命の大切さを学ぶ貴重な体験ができます。\n\n【宮城県石巻市とは？】\n宮城県の東部に位置し、太平洋に面する県内第二の都市です。世界三大漁場・三陸沖の豊かな恵みを受ける日本有数の港町であり、新鮮な海の幸は格別です。\nまた、「萬画の国」として石ノ森章太郎の世界観が街中に広がるほか、猫島として知られる田代島や信仰の島・金華山などの個性的な島々も有しています。\n東日本大震災からの復興を進める力強い姿も、この街の大きな特徴です。\n\n石巻市公式観光サイトはこちら：https://www.i-kanko.com/","publishedAt":"2025-10-07T15:09:17Z","channelTitle":"やなぎさわ誉之(たかゆき)【道は続くよどこまでも】","thumbnails":{"default":{"url":"https://i.ytimg.com/vi/c_muaAm-aQE/default.jpg","width":120,"height":90},"medium":{"url":"https://i.ytimg.com/vi/c_muaAm-aQE/mqdefault.jpg","width":320,"height":180},"high":{"url":"https://i.ytimg.com/vi/c_muaAm-aQE/hqdefault.jpg","width":480,"height":360},"standard":{"url":"https://i.ytimg.com/vi/c_muaAm-aQE/sddefault.jpg","width":640,"height":480},"maxres":{"url":"https://i.ytimg.com/vi/c_muaAm-aQE/maxresdefault.jpg","width":1280,"height":720}},"viewCount":5062,"liveStreaming":{"status":"completed","scheduledStartTime":"2025-10-07T13:30:00Z","actualStartTime":"2025-10-07T13:34:27Z","actualEndTime":"2025-10-07T14:59:52Z"}}]},{"input":"UCY